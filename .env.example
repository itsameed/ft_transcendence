# Application
PORT=3000
SESSION_SECRET=
# Encrypts two-factor secrets at rest. 64 hex chars: openssl rand -hex 32
TWOFA_ENC_KEY=

# Google authentication
GOOGLE_CLIENT_ID=disabled
GOOGLE_CLIENT_SECRET=disabled
GOOGLE_CALLBACK_URL=https://localhost:8443/auth/google/callback

# Email
GMAIL_USER=
GMAIL_PASS=

# AI assistant
GROQ_API_KEY=
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=api.jina.ai
EMBEDDINGS_MODEL=jina-embeddings-v3
EMBEDDINGS_PATH=/v1/embeddings

# MongoDB
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_URL=

# Security
COOKIE_SECURE=true

# Grafana
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=